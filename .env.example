# 복사해서 .env로 사용 (cp .env.example .env). .env는 커밋하지 않는다.

# --- DB (docker-compose와 Spring이 공통으로 사용) ---
POSTGRES_DB=getting_recipe
POSTGRES_PORT=5432
DB_USERNAME=change-me
DB_PASSWORD=change-me
DB_URL=jdbc:postgresql://localhost:5432/getting_recipe

# --- Gemini ---
GEMINI_API_KEY=
# 비워 두면 안 된다(빈 값이 기본값을 덮어씀). 바꿀 때만 주석을 풀 것. 기본: gemini-3.8-flash
# GEMINI_MODEL=gemini-3.8-flash
# true 면 Gemini 호출 없이 샘플 레시피 반환 (키 없이 로컬 개발할 때)
# GEMINI_MOCK=true

# --- YouTube Data API (영상 제목/길이 조회) ---
YOUTUBE_API_KEY=
