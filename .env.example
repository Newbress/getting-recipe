# 복사해서 .env로 사용 (cp .env.example .env). .env는 커밋하지 않는다.

# --- DB (docker-compose와 Spring이 공통으로 사용) ---
POSTGRES_DB=getting_recipe
POSTGRES_PORT=5432
DB_USERNAME=change-me
DB_PASSWORD=change-me
DB_URL=jdbc:postgresql://localhost:5432/getting_recipe

# --- Gemini ---
GEMINI_API_KEY=
GEMINI_MODEL=

# --- YouTube Data API (영상 제목/길이 조회) ---
YOUTUBE_API_KEY=
